{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CTR",
  "version": "0.1.0",
  "identifier": "com.ctr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CTR - Custom Training Timer",
        "width": 1080,
        "height": 720,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      },
      {
  "label": "pomodoro-mini",
  "title": "CTR Focus",
  "url": "index.html?window=pomodoro-mini",
  "width": 260,
  "height": 140,
  "resizable": false,
  "decorations": false,
  "alwaysOnTop": true,
  "transparent": false,
  "visible": false,
  "skipTaskbar": false,
  "shadow": true
}
    ],

    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
